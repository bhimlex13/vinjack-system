# --- Server environment configuration (copy to .env and fill in values) ---

# Express server port
PORT=5000

# MongoDB connection string (MongoDB Atlas or local Community Edition)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<dbname>?retryWrites=true&w=majority

# JWT signing secret (use a long, random string)
JWT_SECRET=replace_with_a_long_random_secret

# Frontend origin (CORS)
CLIENT_URL=http://localhost:3000

# --- Email notification settings (Nodemailer via Gmail) ---
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_gmail_app_password

# --- Google Cloud Storage (database backups) ---
GCS_BUCKET_NAME=your-backup-bucket-name
GOOGLE_APPLICATION_CREDENTIALS=./gcs-key.json